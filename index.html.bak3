<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<script>try{document.documentElement.setAttribute('data-theme',localStorage.getItem('acak-theme')||'dark');}catch(e){}</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#0a0e1a" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="mobile-web-app-capable" content="yes" />
<title>Acak Siswa</title>
<script src="./xlsx.full.min.js"></script>
<style>
  :root{
    --bg:#0a0e1a; --bg-2:#0e1422;
    --surface:#141a2c; --surface-2:#1c2338; --surface-3:#262f4a;
    --border:#2a3352; --border-2:#3a4466;
    --text-1:#f0f3fb; --text-2:#9aa6c4; --text-3:#667192;
    --accent:#ffb340; --accent-2:#ff8a3d;
    --accent-soft:rgba(255,179,64,.14); --accent-ink:#1a1204;
    --blue:#6aa9ff; --green:#4cd9a0; --red:#ff6b7e;
    --r-sm:10px; --r-md:14px; --r-lg:20px; --r-xl:26px; --r-full:999px;
    --sh-accent:0 10px 28px rgba(255,179,64,.35);
    --safe-top:env(safe-area-inset-top,0px);
    --safe-bottom:env(safe-area-inset-bottom,0px);
    --safe-left:env(safe-area-inset-left,0px);
    --safe-right:env(safe-area-inset-right,0px);
    /* tuned animation tokens — durasi pendek biar ringan */
    --t-fast:.12s;
    --t-med:.2s;
    --t-slow:.28s;
  }
  *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
  html,body{height:100%;overscroll-behavior:none;}
  html{-webkit-text-size-adjust:100%;}
  body{
    font-family:'Inter','Segoe UI',Roboto,system-ui,-apple-system,sans-serif;
    background:var(--bg); color:var(--text-1);
    height:100dvh; overflow:hidden;
    font-size:16px; line-height:1.4;
    -webkit-font-smoothing:antialiased;
    user-select:none;
  }

  /* ---------- App shell ---------- */
  .app{
    display:flex; flex-direction:column;
    height:100dvh;
    padding-left:var(--safe-left);
    padding-right:var(--safe-right);
    background:var(--surface);
    max-width:560px; margin:0 auto; width:100%;
    position:relative;
    contain:layout style;
  }

  /* ---------- Top bar ---------- */
  .topbar{
    flex:0 0 auto;
    padding: calc(var(--safe-top) + 8px) 12px 8px;
    display:flex; align-items:center; gap:8px;
    border-bottom:1px solid var(--border);
    background:var(--surface);
    contain:content;
  }
  .brand{display:flex;align-items:center;gap:8px;min-width:0;flex:1;}
  .brand .logo{
    width:32px;height:32px;border-radius:10px;
    background:linear-gradient(135deg,var(--accent) 0%,var(--accent-2) 100%);
    display:grid;place-items:center;font-size:17px;flex-shrink:0;
  }
  .brand .txt{min-width:0;}
  .brand h1{
    font-size:.98rem; font-weight:700; letter-spacing:-.02em;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .brand .sub{
    font-size:.66rem; color:var(--text-3); font-weight:500; margin-top:-1px;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .rng-chip{
    font-size:.6rem;color:var(--text-3);
    border:1px solid var(--border); padding:4px 9px;
    border-radius:var(--r-full); white-space:nowrap;
    display:flex;align-items:center;gap:5px;flex-shrink:0;
  }
  .rng-chip .dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--green);
    animation:pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.35;}}

  /* ---------- Tabs ---------- */
  .tabbar{
    flex:0 0 auto;
    padding:8px 12px;
    display:flex; align-items:center; gap:6px;
    border-bottom:1px solid var(--border);
    contain:content;
  }
  .tabs{
    flex:1; display:flex; gap:6px;
    overflow-x:auto; scrollbar-width:none;
    padding:1px 0;
    -webkit-overflow-scrolling:touch;
  }
  .tabs::-webkit-scrollbar{display:none;}
  .tab{
    background:var(--surface-2); border:1px solid var(--border);
    padding:8px 12px; border-radius:var(--r-full);
    font-size:.78rem; font-weight:500; color:var(--text-2);
    display:flex; align-items:center; gap:7px;
    white-space:nowrap; flex-shrink:0; min-height:36px;
    font-family:inherit; cursor:pointer;
    /* animasi hanya color & border-color + transform. color = paint, tapi
       hanya 1 elemen kecil, jangka pendek — tidak masalah. */
    transition:color var(--t-fast), border-color var(--t-fast);
  }
  .tab.active{
    background:var(--accent-soft); border-color:var(--accent);
    color:var(--accent); font-weight:600;
  }
  .tab .x{
    opacity:.5; font-size:.75rem; line-height:1;
    width:16px;height:16px; display:grid; place-items:center;
    border-radius:50%;
  }
  .tab-add{
    flex-shrink:0; width:36px; height:36px; border-radius:50%;
    background:var(--surface-2); border:1px dashed var(--border-2);
    color:var(--text-2); font-size:18px;
    display:grid; place-items:center; cursor:pointer; font-family:inherit;
    transition:transform var(--t-fast);
  }
  .tab-add:active{transform:scale(.9);}

  /* ---------- HERO ---------- */
  .hero{
    flex:1 1 auto; min-height:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:16px 20px; gap:12px;
    position:relative; overflow:hidden;
    contain:layout paint;
  }
  /* Glow layer — opacity-animated, GPU composited */
  .hero-glow{
    position:absolute; inset:0;
    background:radial-gradient(circle at 50% 45%,rgba(255,179,64,.22) 0%,transparent 60%);
    opacity:0;
    transition:opacity var(--t-slow) ease-out;
    pointer-events:none;
    will-change:opacity;
    z-index:0;
  }
  .hero.has-result .hero-glow{opacity:1;}

  .hero-badges{
    position:absolute; top:14px; left:16px; right:16px;
    display:flex; justify-content:space-between; gap:8px;
    pointer-events:none; z-index:2;
  }
  .hero-badges .b{
    background:rgba(0,0,0,.4);
    padding:5px 11px; border-radius:var(--r-full);
    font-size:.66rem; font-weight:600;
    display:inline-flex; align-items:center; gap:5px;
    border:1px solid rgba(255,255,255,.06);
    color:var(--text-2);
  }
  .hero-badges .b.order{border-color:rgba(106,169,255,.4);color:var(--blue);}
  .hero-badges .b.repeat{border-color:rgba(76,217,160,.4);color:var(--green);}
  .hero-badges .b[hidden]{display:none;}

  /* Wrapper supaya animasi pop tidak repaint teks glow */
  .result-wrap{
    position:relative; z-index:1;
    display:flex; align-items:center; justify-content:center;
    max-width:100%;
    will-change:transform;
  }
  .result-wrap.pop{animation:pop .38s cubic-bezier(.34,1.4,.64,1);}
  @keyframes pop{
    0%{transform:scale(.72);}
    100%{transform:scale(1);}
  }

  .result-name{
    font-size:clamp(2.2rem,11vw,3.4rem);
    font-weight:800; letter-spacing:-.03em;
    text-align:center; line-height:1.05;
    color:var(--text-1);
    word-break:break-word; overflow-wrap:anywhere; hyphens:auto;
    padding:0 8px;
    transition:color var(--t-med) ease-out;
    /* NO text-shadow — glow sudah dari .hero-glow */
  }
  .result-name.empty{
    font-size:clamp(1.05rem,4.6vw,1.4rem);
    font-weight:500; color:var(--text-3); line-height:1.5;
  }
  .result-name.picked{color:var(--accent);}

  .hero-preview{
    font-size:.74rem; color:var(--text-3);
    text-align:center; line-height:1.6;
    max-width:100%; z-index:1;
    padding:8px 12px;
    background:rgba(0,0,0,.3);
    border-radius:var(--r-full);
  }
  .hero-preview .upcoming{color:var(--text-2);font-weight:600;}
  .hero-preview[hidden]{display:none;}

  /* ---------- Primary action ---------- */
  .action-area{
    flex:0 0 auto;
    padding:0 12px 10px;
    display:flex; flex-direction:column; gap:8px;
    contain:content;
  }

  .btn-acak{
    background:linear-gradient(135deg,var(--accent) 0%,var(--accent-2) 100%);
    color:var(--accent-ink);
    font-family:inherit;
    font-size:1.15rem; font-weight:800;
    letter-spacing:.1em; text-transform:uppercase;
    padding:18px; min-height:60px;
    border:none; border-radius:var(--r-lg);
    box-shadow:var(--sh-accent);
    cursor:pointer;
    display:flex; align-items:center; justify-content:center; gap:10px;
    /* transform-only untuk feedback tekan */
    transition:transform .1s ease-out;
    touch-action:manipulation;
    will-change:transform;
    position:relative; overflow:hidden;
  }
  .btn-acak:active:not(:disabled){transform:scale(.96);}
  .btn-acak:disabled{opacity:.5; cursor:not-allowed;}
  .btn-acak .emoji{font-size:1.35rem;}

  /* ---------- Secondary actions ---------- */
  .actions{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:4px;
  }
  .act{
    background:var(--surface-2);
    border:1px solid var(--border);
    border-radius:var(--r-md);
    padding:10px 4px; min-height:56px;
    font-family:inherit; font-size:.68rem; font-weight:600;
    color:var(--text-2);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px;
    cursor:pointer; min-width:0; white-space:nowrap;
    transition:transform .1s ease-out;
    touch-action:manipulation;
    will-change:transform;
  }
  .act .ico{font-size:1.15rem; line-height:1;}
  .act:active:not(:disabled){transform:scale(.94);}
  .act:disabled{opacity:.35; cursor:not-allowed;}
  .act.accent{border-color:rgba(255,179,64,.4); color:var(--accent); background:var(--accent-soft);}

  /* ---------- History strip ---------- */
  .hist-wrap{
    flex:0 0 auto;
    padding:0 12px 8px;
    contain:content;
  }
  .hist-wrap[hidden]{display:none;}
  .hist{
    display:flex; gap:6px;
    overflow-x:auto; scrollbar-width:none;
    padding:2px 0;
    -webkit-overflow-scrolling:touch;
  }
  .hist::-webkit-scrollbar{display:none;}
  .hist-chip{
    background:var(--surface-2); border:1px solid var(--border);
    color:var(--text-2); font-size:.7rem; font-weight:500;
    padding:6px 11px; border-radius:var(--r-full);
    white-space:nowrap; flex-shrink:0;
    min-height:30px; display:inline-flex; align-items:center;
  }
  .hist-chip.latest{
    background:var(--accent-soft); border-color:var(--accent);
    color:var(--accent); font-weight:600;
  }

  /* ---------- Footer ---------- */
  .foot{
    flex:0 0 auto;
    padding:8px 12px calc(var(--safe-bottom) + 10px);
    display:flex; align-items:center; justify-content:space-between;
    gap:8px; font-size:.72rem;
    border-top:1px solid var(--border);
    background:var(--surface);
    contain:content;
  }
  .foot .stat{
    color:var(--text-2); font-weight:500;
    background:var(--surface-2); border:1px solid var(--border);
    padding:7px 12px; border-radius:var(--r-full);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    display:flex; align-items:center; gap:6px;
    min-width:0; max-width:60%;
  }
  .foot .stat .num{color:var(--text-1);font-weight:700;}
  .foot .stat .absent{color:#f7c948;}
  .copy-btn{
    background:var(--surface-2); border:1px solid var(--border);
    color:var(--text-2); padding:8px 14px; border-radius:var(--r-full);
    font-family:inherit; font-size:.72rem; font-weight:600;
    cursor:pointer; flex-shrink:0;
    display:flex; align-items:center; gap:6px;
    min-height:36px;
    transition:transform .1s ease-out;
    touch-action:manipulation;
  }
  .copy-btn:active{transform:scale(.94);}

  /* ---------- Bottom Sheet ---------- */
  .sheet-bd{
    position:fixed; inset:0; background:rgba(0,0,0,.65);
    opacity:0; pointer-events:none;
    transition:opacity var(--t-med) ease-out;
    z-index:900;
    will-change:opacity;
  }
  .sheet-bd.show{opacity:1; pointer-events:auto;}
  .sheet{
    position:fixed; left:0; right:0; bottom:0;
    background:var(--surface);
    border-top:1px solid var(--border-2);
    border-radius:var(--r-xl) var(--r-xl) 0 0;
    padding:8px 14px calc(var(--safe-bottom) + 14px);
    display:flex; flex-direction:column; gap:10px;
    transform:translate3d(0,100%,0);
    transition:transform var(--t-slow) cubic-bezier(.32,.72,0,1);
    z-index:901;
    max-height:88dvh;
    box-shadow:0 -16px 48px rgba(0,0,0,.6);
    max-width:560px; margin:0 auto;
    will-change:transform;
    contain:layout;
  }
  .sheet.show{transform:translate3d(0,0,0);}
  .sheet-handle{
    width:40px;height:4px;border-radius:2px;
    background:var(--border-2); margin:4px auto 8px;
    flex-shrink:0;
  }
  .sheet-head{
    display:flex; align-items:center; justify-content:space-between;
    gap:10px; flex-shrink:0;
  }
  .sheet-head h3{font-size:1rem;font-weight:700;}
  .sheet-head .sub{
    font-size:.72rem; color:var(--text-2); font-weight:500;
    background:var(--surface-2); padding:4px 10px; border-radius:var(--r-full);
  }
  .sheet textarea{
    flex:1 1 auto; min-height:180px;
    background:var(--bg-2);
    border:1px solid var(--border); border-radius:var(--r-md);
    padding:14px 16px;
    font-size:1rem; font-family:inherit; color:var(--text-1);
    resize:none; line-height:1.6;
    transition:border-color var(--t-fast);
    user-select:text;
    -webkit-user-select:text;
  }
  .sheet textarea:focus{outline:none; border-color:var(--accent);}
  .sheet textarea::placeholder{color:var(--text-3);}
  .sheet-tip{
    font-size:.72rem; color:var(--text-3); line-height:1.55;
    background:var(--surface-2); padding:10px 12px; border-radius:var(--r-sm);
    display:flex; gap:8px; align-items:flex-start;
    flex-shrink:0;
  }
  .sheet-tip code{
    background:var(--bg-2); padding:1px 6px; border-radius:5px;
    color:var(--accent); font-size:.92em; font-family:monospace;
  }
  .sheet-actions{display:flex; gap:8px; flex-shrink:0;}
  .sheet-actions .btn{
    flex:1; padding:14px; min-height:52px;
    border-radius:var(--r-md);
    font-family:inherit; font-weight:700; font-size:.92rem;
    border:1px solid var(--border);
    background:var(--surface-2); color:var(--text-1);
    cursor:pointer;
    transition:transform .1s ease-out;
    touch-action:manipulation;
    will-change:transform;
  }
  .sheet-actions .btn:active{transform:scale(.97);}
  .sheet-actions .btn-primary{
    background:linear-gradient(135deg,var(--accent),var(--accent-2));
    color:var(--accent-ink); border:none;
  }
  .sheet-actions .btn-clear{
    flex:0 0 auto; padding:14px 18px;
    background:transparent; border-color:var(--red); color:var(--red);
  }

  /* ---------- Menu ---------- */
  .menu-bd{
    position:fixed; inset:0; z-index:800; display:none;
  }
  .menu-bd.show{display:block;}
  .menu{
    position:fixed;
    right:12px;
    bottom:calc(var(--safe-bottom) + 140px);
    background:var(--surface-3);
    border:1px solid var(--border-2);
    border-radius:var(--r-md);
    padding:6px;
    min-width:min(260px,80vw);
    max-width:min(320px,92vw);
    max-height:calc(100dvh - 240px - var(--safe-bottom));
    overflow-y:auto;
    overflow-x:hidden;
    -webkit-overflow-scrolling:touch;
    overscroll-behavior:contain;
    box-shadow:0 8px 24px rgba(0,0,0,.4);
    opacity:0;
    transform:translate3d(0,8px,0) scale(.96);
    pointer-events:none;
    transform-origin:bottom right;
    transition:opacity var(--t-fast) ease-out, transform var(--t-fast) ease-out;
    z-index:801;
    will-change:transform,opacity;
    scrollbar-width:thin;
  }
  .menu::-webkit-scrollbar{width:5px;}
  .menu::-webkit-scrollbar-thumb{background:var(--border-2);border-radius:3px;}
  .menu::-webkit-scrollbar-track{background:transparent;}
  .menu.show{opacity:1; transform:translate3d(0,0,0) scale(1); pointer-events:auto;}
  .menu-item{
    width:100%;
    background:transparent; border:none;
    color:var(--text-1); font-family:inherit; font-size:.88rem;
    padding:12px; min-height:46px;
    border-radius:var(--r-sm);
    display:flex; align-items:center; gap:12px;
    cursor:pointer; text-align:left;
    transition:background var(--t-fast);
    touch-action:manipulation;
  }
  .menu-item:active{background:rgba(255,255,255,.07);}
  .menu-item .ico{font-size:1.1rem;width:22px;text-align:center;flex-shrink:0;}
  .menu-item .lbl{flex:1;white-space:nowrap;}
  .menu-item .sw{
    width:36px;height:20px;border-radius:10px;
    background:var(--surface-2); border:1px solid var(--border);
    position:relative; flex-shrink:0;
    transition:background var(--t-fast);
  }
  .menu-item .sw::after{
    content:''; position:absolute; top:1px; left:1px;
    width:16px;height:16px;border-radius:50%;
    background:var(--text-3);
    transition:transform var(--t-med) cubic-bezier(.4,0,.2,1), background var(--t-fast);
    will-change:transform;
  }
  .menu-item .sw.on{background:var(--accent); border-color:var(--accent);}
  .menu-item .sw.on::after{transform:translate3d(16px,0,0);background:var(--accent-ink);}
  .menu-sep{height:1px;background:var(--border);margin:5px 8px;}

  /* ---------- Modal ---------- */
  .modal-bd{
    position:fixed; inset:0; background:rgba(0,0,0,.7);
    display:none; align-items:center; justify-content:center;
    z-index:1000; padding:20px;
  }
  .modal-bd.show{display:flex;}
  .modal{
    background:var(--surface); border:1px solid var(--border);
    border-radius:var(--r-lg); padding:20px;
    width:100%; max-width:360px;
    box-shadow:0 8px 24px rgba(0,0,0,.4);
    animation:mIn var(--t-med) cubic-bezier(.34,1.4,.64,1);
    will-change:transform,opacity;
  }
  @keyframes mIn{
    from{transform:scale(.9);opacity:0;}
    to{transform:scale(1);opacity:1;}
  }
  .modal h3{font-size:1rem; font-weight:700; margin-bottom:14px;}
  .modal input{
    width:100%; background:var(--bg-2);
    border:1px solid var(--border); border-radius:var(--r-md);
    padding:14px; color:var(--text-1);
    font-size:1rem; font-family:inherit;
    margin-bottom:14px;
    transition:border-color var(--t-fast);
    user-select:text;
    -webkit-user-select:text;
  }
  .modal input:focus{outline:none; border-color:var(--accent);}
  .modal-acts{display:flex; gap:10px;}
  .modal-acts .btn{
    flex:1; padding:13px; min-height:48px;
    border-radius:var(--r-md);
    font-family:inherit; font-weight:600; font-size:.9rem;
    border:1px solid var(--border); background:var(--surface-2);
    color:var(--text-1); cursor:pointer;
    transition:transform .1s ease-out;
    touch-action:manipulation;
  }
  .modal-acts .btn:active{transform:scale(.97);}
  .modal-acts .btn-primary{
    background:linear-gradient(135deg,var(--accent),var(--accent-2));
    color:var(--accent-ink); border:none;
  }

  /* ---------- Toast ---------- */
  #toastWrap{
    position:fixed;
    bottom:calc(var(--safe-bottom) + 20px);
    left:50%;
    transform:translate3d(-50%,0,0);
    display:flex; flex-direction:column; gap:6px;
    z-index:1100;
    width:min(340px,calc(100vw - 32px));
    pointer-events:none;
  }
  .toast{
    background:var(--surface-3); border:1px solid var(--border-2);
    color:var(--text-1); padding:12px 16px;
    border-radius:var(--r-md); font-size:.85rem; font-weight:500;
    box-shadow:0 6px 20px rgba(0,0,0,.4);
    display:flex; align-items:center; gap:10px;
    animation:tIn var(--t-med) cubic-bezier(.34,1.4,.64,1);
    will-change:transform,opacity;
  }
  .toast.error{border-color:var(--red);}
  .toast.error::before{content:'⚠️';font-size:1.1rem;}
  .toast.success{border-color:var(--green);}
  .toast.success::before{content:'✓';color:var(--green);font-weight:800;font-size:1.1rem;}
  .toast.info::before{content:'ℹ';color:var(--blue);font-weight:800;font-size:1.1rem;}
  @keyframes tIn{
    from{transform:translate3d(0,16px,0);opacity:0;}
    to{transform:translate3d(0,0,0);opacity:1;}
  }

  /* ---------- Low-end mode ----------
     Kelas ini ditambahkan ke <html> via JS kalau device terdeteksi low-end
     atau user minta prefers-reduced-motion. Semua animasi di-mute. */
  html.lowend .rng-chip .dot{animation:none;}
  html.lowend .result-wrap.pop{animation:none;}
  html.lowend .sheet,
  html.lowend .menu,
  html.lowend .sheet-bd{transition:none;}
  html.lowend .modal{animation:none;}
  html.lowend .toast{animation:none;}
  html.lowend .btn-acak,
  html.lowend .act,
  html.lowend .copy-btn,
  html.lowend .tab-add,
  html.lowend .sheet-actions .btn,
  html.lowend .modal-acts .btn{transition:none;}
  html.lowend .hero-glow{transition:none;}

  /* prefers-reduced-motion: matikan semua animasi dekoratif */
  @media (prefers-reduced-motion: reduce){
    *,*::before,*::after{
      animation-duration:.01ms !important;
      animation-iteration-count:1 !important;
      transition-duration:.01ms !important;
    }
  }

  /* Landscape / layar pendek */
  @media (max-height:600px){
    .result-name{font-size:clamp(1.8rem,7vw,2.4rem);}
    .btn-acak{padding:14px;font-size:1rem;min-height:52px;}
    .act{padding:8px 3px;min-height:48px;font-size:.64rem;}
    .act .ico{font-size:1rem;}
    .hero{padding:10px 16px;gap:8px;}
    .brand .sub{display:none;}
  }
  @media (max-width:340px){
    .act{font-size:.6rem;padding:9px 2px;}
    .brand h1{font-size:.9rem;}
  }

  /* ---------- Light theme ---------- */
  html[data-theme="light"]{
    --bg:#f2f5fa; --bg-2:#e9eef6;
    --surface:#ffffff; --surface-2:#eef2f9; --surface-3:#e2e8f2;
    --border:#d5deea; --border-2:#b8c4d6;
    --text-1:#172033; --text-2:#4f5d78; --text-3:#8a95ac;
    --accent:#d97706; --accent-2:#c25e00;
    --accent-soft:rgba(217,119,6,.12); --accent-ink:#ffffff;
    --blue:#1e63e0; --green:#0f9d58; --red:#d92a3e;
  }
  html[data-theme="light"] .rng-chip .dot{box-shadow:0 0 8px #0f9d58;}
  html[data-theme="light"] .hero-glow{
    background:radial-gradient(circle at 50% 45%,rgba(217,119,6,.18) 0%,transparent 60%);
  }
  html[data-theme="light"] .timer{background:rgba(0,0,0,.75);}

  /* ---------- Timer overlay ---------- */
  .timer{
    position:absolute; top:52px; left:50%; transform:translateX(-50%);
    background:rgba(0,0,0,.55); color:#fff;
    padding:7px 16px; border-radius:var(--r-full);
    font-size:1.05rem; font-weight:800;
    font-variant-numeric:tabular-nums; letter-spacing:.02em;
    z-index:4; border:1px solid rgba(255,255,255,.12);
    box-shadow:0 4px 16px rgba(0,0,0,.3);
    animation:timerIn .3s cubic-bezier(.34,1.4,.64,1);
  }
  .timer[hidden]{display:none;}
  .timer.ending{color:#ff8a8a;animation:timerPulse .8s infinite;}
  @keyframes timerIn{from{opacity:0;transform:translate(-50%,-8px);}to{opacity:1;transform:translate(-50%,0);}}
  @keyframes timerPulse{0%,100%{opacity:1;}50%{opacity:.5;}}

  /* ---------- Groups sheet ---------- */
  .group-input-row{
    display:flex; gap:8px; align-items:center; flex-shrink:0;
  }
  .group-input-row input{
    flex:1; background:var(--bg-2); border:1px solid var(--border);
    border-radius:var(--r-md); padding:11px 14px; color:var(--text-1);
    font-size:1rem; font-family:inherit; font-variant-numeric:tabular-nums;
  }
  .group-input-row input:focus{outline:none; border-color:var(--accent);}
  .group-input-row .btn{flex:0 0 auto; padding:11px 20px; min-height:auto;}

  .group-card{
    background:var(--surface-2); border:1px solid var(--border);
    border-radius:var(--r-md); padding:12px 14px; margin-bottom:10px;
    animation:groupIn .3s cubic-bezier(.34,1.4,.64,1) backwards;
  }
  .group-card:nth-child(1){animation-delay:0s;}
  .group-card:nth-child(2){animation-delay:.04s;}
  .group-card:nth-child(3){animation-delay:.08s;}
  .group-card:nth-child(4){animation-delay:.12s;}
  .group-card:nth-child(5){animation-delay:.16s;}
  .group-card:nth-child(6){animation-delay:.2s;}
  @keyframes groupIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
  .group-title{
    font-weight:700; font-size:.92rem; color:var(--accent);
    margin-bottom:8px; display:flex; justify-content:space-between; align-items:center;
  }
  .group-title .cnt{font-weight:500; color:var(--text-3); font-size:.72rem;}
  .group-list{list-style:none; padding:0; margin:0; counter-reset:g;}
  .group-list li{
    padding:5px 0; font-size:.9rem;
    border-bottom:1px solid var(--border);
    counter-increment:g;
    display:flex; gap:8px;
  }
  .group-list li::before{
    content:counter(g) ".";
    color:var(--text-3); font-size:.78rem; font-weight:600;
    min-width:20px;
  }
  .group-list li:last-child{border-bottom:none;}

  /* ---------- Stats sheet ---------- */
  .stats-section{margin-bottom:18px;}
  .stats-section:last-child{margin-bottom:0;}
  .stats-title{
    font-size:.72rem; font-weight:700; text-transform:uppercase;
    letter-spacing:.06em; color:var(--text-3); margin-bottom:10px;
  }
  .stat-row{
    display:grid; grid-template-columns:1fr 90px 44px;
    gap:8px; align-items:center; padding:5px 0;
    font-size:.86rem;
  }
  .stat-name{white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-weight:500;}
  .stat-bar{
    background:var(--surface-2); border-radius:4px;
    height:8px; overflow:hidden;
  }
  .stat-fill{
    background:linear-gradient(90deg,var(--accent),var(--accent-2));
    height:100%; border-radius:4px;
    transition:width .5s cubic-bezier(.4,0,.2,1);
  }
  .stat-count{
    text-align:right; color:var(--text-2); font-weight:700;
    font-variant-numeric:tabular-nums;
  }
  .stats-never{
    font-size:.82rem; color:var(--text-2); line-height:1.7;
    background:var(--surface-2); border-radius:var(--r-sm);
    padding:10px 12px;
  }
  .stats-empty{
    text-align:center; color:var(--text-3); font-size:.85rem;
    padding:24px 12px;
  }

  html.lowend .group-card{animation:none;}
  html.lowend .timer{animation:none;}
  html.lowend .timer.ending{animation:none;color:#ff8a8a;}
</style>
<link rel="manifest" href="./manifest.json" />
<link rel="apple-touch-icon" href="./icon-192.png" />
<link rel="icon" type="image/png" href="./icon-192.png" />
<meta name="application-name" content="Acak Siswa" />
</head>
<body>

<div class="app">

  <div class="topbar">
    <div class="brand">
      <div class="logo">🎓</div>
      <div class="txt">
        <h1>Acak Siswa</h1>
        <div class="sub">Pengacak &amp; urutan kelas</div>
      </div>
    </div>
    <div class="rng-chip" title="Random dari Web Crypto API">
      <span class="dot"></span>Crypto
    </div>
  </div>

  <div class="tabbar">
    <div class="tabs" id="tabScroll"></div>
    <button class="tab-add" id="addTabBtn" aria-label="Tambah kelas">+</button>
  </div>

  <div class="hero" id="hero">
    <div class="hero-glow"></div>
    <div class="hero-badges">
      <span class="b" id="modeBadge">⚡ Acak</span>
      <span class="b repeat" id="repeatIndicator" hidden>0/0</span>
    </div>
    <div class="timer" id="timerEl" hidden>0:00</div>
    <div class="result-wrap" id="resultWrap">
      <div class="result-name empty" id="resultDisplay">Siap mengacak</div>
    </div>
    <div class="hero-preview" id="previewList" hidden></div>
  </div>

  <div class="action-area">
    <button class="btn-acak" id="pickBtn" aria-label="Acak satu nama">
      <span class="emoji">🎲</span>Acak
    </button>
    <div class="actions">
      <button class="act accent" id="openListBtn" aria-label="Buka daftar siswa">
        <span class="ico">📝</span>Daftar
      </button>
      <button class="act" id="nextOrderBtn" aria-label="Urutan berikutnya">
        <span class="ico">▶</span>Urutan
      </button>
      <button class="act" id="shuffleBtn" aria-label="Kocok urutan daftar">
        <span class="ico">🔀</span>Kocok
      </button>
      <button class="act" id="excelBtn" aria-label="Impor Excel">
        <span class="ico">📂</span>Excel
      </button>
      <button class="act" id="menuBtn" aria-label="Menu lainnya">
        <span class="ico">⋯</span>Lainnya
      </button>
    </div>
  </div>

  <div class="hist-wrap" id="histWrap" hidden>
    <div class="hist" id="historyStrip"></div>
  </div>

  <div class="foot">
    <span class="stat" id="studentCount"><span class="num">0</span> siswa</span>
    <button class="copy-btn" id="copyResultBtn" aria-label="Salin hasil">📋 Salin</button>
  </div>

</div>

<div class="menu-bd" id="menuBackdrop"></div>
<div class="menu" id="menu">
  <button class="menu-item" id="menuNoRepeat">
    <span class="ico">🔁</span>
    <span class="lbl">Tanpa ulang</span>
    <span class="sw" id="noRepeatSw"></span>
  </button>
  <button class="menu-item" id="menuExcel"><span class="ico">📂</span><span class="lbl">Impor Excel</span></button>
  <div class="menu-sep"></div>
  <button class="menu-item" id="menuUndo"><span class="ico">↶</span><span class="lbl">Batalkan shuffle</span></button>
  <button class="menu-item" id="menuExport"><span class="ico">⬇</span><span class="lbl">Ekspor riwayat</span></button>
  <div class="menu-sep"></div>
  <button class="menu-item" id="menuGroups"><span class="ico">👥</span><span class="lbl">Bagi kelompok</span></button>
  <button class="menu-item" id="menuPickN"><span class="ico">🎲</span><span class="lbl">Acak N nama</span></button>
  <button class="menu-item" id="menuStats"><span class="ico">📊</span><span class="lbl">Statistik</span></button>
  <button class="menu-item" id="menuSort"><span class="ico">📈</span><span class="lbl">Urutkan A-Z</span></button>
  <button class="menu-item" id="menuTimer"><span class="ico">⏱️</span><span class="lbl">Timer maju</span></button>
  <div class="menu-sep"></div>
  <button class="menu-item" id="menuShare"><span class="ico">📤</span><span class="lbl">Bagikan hasil</span></button>
  <button class="menu-item" id="menuBackup"><span class="ico">💾</span><span class="lbl">Backup data</span></button>
  <button class="menu-item" id="menuRestore"><span class="ico">📥</span><span class="lbl">Restore backup</span></button>
  <div class="menu-sep"></div>
  <button class="menu-item" id="menuTheme"><span class="ico">🌞</span><span class="lbl">Mode terang</span><span class="sw" id="themeSw"></span></button>
  <button class="menu-item" id="menuSound"><span class="ico">🔊</span><span class="lbl">Suara</span><span class="sw" id="soundSw"></span></button>
  <div class="menu-sep"></div>
  <button class="menu-item" id="menuReset"><span class="ico">↺</span><span class="lbl">Reset ke contoh</span></button>
</div>

<div class="sheet-bd" id="sheetBackdrop"></div>
<div class="sheet" id="sheet" role="dialog" aria-modal="true">
  <div class="sheet-handle"></div>
  <div class="sheet-head">
    <h3>Daftar Siswa</h3>
    <span class="sub" id="sheetSub">0 siswa</span>
  </div>
  <textarea id="studentList" placeholder="Andi, Budi, Cici, Dedi, ..." autocomplete="off" autocorrect="off" autocapitalize="words" spellcheck="false"></textarea>
  <div class="sheet-tip">
    <span>💡</span>
    <span>Pisahkan dengan koma atau baris baru. Awali <code>-</code> untuk tandai absen (contoh <code>-Dedi</code>).</span>
  </div>
  <div class="sheet-actions">
    <button class="btn btn-clear" id="sheetClearBtn" aria-label="Kosongkan">🗑</button>
    <button class="btn btn-primary" id="sheetDoneBtn">Simpan</button>
  </div>
</div>

<div class="modal-bd" id="renameBackdrop">
  <div class="modal">
    <h3>Nama kelas</h3>
    <input type="text" id="renameInput" maxlength="30" placeholder="Contoh: Kelas 1A" autocomplete="off" />
    <div class="modal-acts">
      <button class="btn" id="renameCancel">Batal</button>
      <button class="btn btn-primary" id="renameConfirm">Simpan</button>
    </div>
  </div>
</div>

<!-- Bagi kelompok -->
<div class="sheet-bd" id="groupsBackdrop"></div>
<div class="sheet" id="groupsSheet" role="dialog" aria-modal="true">
  <div class="sheet-handle"></div>
  <div class="sheet-head">
    <h3>Bagi Kelompok</h3>
    <span class="sub" id="groupsSub">—</span>
  </div>
  <div class="group-input-row">
    <input type="number" id="groupCount" min="2" max="20" value="4"
           inputmode="numeric" aria-label="Jumlah kelompok" />
    <button class="btn btn-primary" id="groupsGoBtn">Bagi</button>
  </div>
  <div id="groupsBody" style="overflow-y:auto;flex:1;min-height:0;max-height:50vh;"></div>
  <div class="sheet-actions">
    <button class="btn" id="groupsShareBtn">📤 Bagikan</button>
    <button class="btn btn-primary" id="groupsDoneBtn">Tutup</button>
  </div>
</div>

<!-- Statistik -->
<div class="sheet-bd" id="statsBackdrop"></div>
<div class="sheet" id="statsSheet" role="dialog" aria-modal="true">
  <div class="sheet-handle"></div>
  <div class="sheet-head">
    <h3>Statistik</h3>
    <span class="sub" id="statsSub">—</span>
  </div>
  <div id="statsBody" style="overflow-y:auto;flex:1;min-height:0;"></div>
  <div class="sheet-actions">
    <button class="btn btn-primary" id="statsDoneBtn">Tutup</button>
  </div>
</div>

<input type="file" id="backupInput" accept=".json" style="display:none;" />

<div id="toastWrap"></div>
<input type="file" id="excelInput" accept=".xlsx,.xls" style="display:none;" />

<script>
(function(){
  "use strict";

  /* ---------- Deteksi low-end & preferensi motion ---------- */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lowConcurrency = (navigator.hardwareConcurrency || 8) <= 4;
  const lowMemory = navigator.deviceMemory !== undefined && navigator.deviceMemory <= 2;
  const isLowEnd = reduceMotion || lowConcurrency || lowMemory;
  const LOW_FPS_SPIN = isLowEnd;      // spin di ~30fps kalau low-end
  if (isLowEnd) document.documentElement.classList.add('lowend');
  // expose untuk debug: window.__acakPerf = {reduceMotion, lowConcurrency, lowMemory, isLowEnd};

  const $ = id => document.getElementById(id);
  const tabScroll = $('tabScroll');
  const addTabBtn = $('addTabBtn');
  const textarea = $('studentList');
  const pickBtn = $('pickBtn');
  const resultDisplay = $('resultDisplay');
  const resultWrap = $('resultWrap');
  const hero = $('hero');
  const studentCountSpan = $('studentCount');
  const copyBtn = $('copyResultBtn');
  const excelInput = $('excelInput');
  const nextOrderBtn = $('nextOrderBtn');
  const shuffleBtn = $('shuffleBtn');
  const openListBtn = $('openListBtn');
  const menuBtn = $('menuBtn');
  const menu = $('menu');
  const menuBackdrop = $('menuBackdrop');
  const menuNoRepeat = $('menuNoRepeat');
  const menuUndo = $('menuUndo');
  const menuExcel = $('menuExcel');
  const menuExport = $('menuExport');
  const menuReset = $('menuReset');
  const noRepeatSw = $('noRepeatSw');
  const modeBadge = $('modeBadge');
  const repeatIndicator = $('repeatIndicator');
  const previewList = $('previewList');
  const histWrap = $('histWrap');
  const historyStrip = $('historyStrip');
  const toastWrap = $('toastWrap');
  const sheetBackdrop = $('sheetBackdrop');
  const sheet = $('sheet');
  const sheetSub = $('sheetSub');
  const sheetDoneBtn = $('sheetDoneBtn');
  const sheetClearBtn = $('sheetClearBtn');
  const renameBackdrop = $('renameBackdrop');
  const renameInput = $('renameInput');
  const renameConfirm = $('renameConfirm');
  const renameCancel = $('renameCancel');
  const groupsBackdrop = $('groupsBackdrop');
  const groupsSheet = $('groupsSheet');
  const groupsBody = $('groupsBody');
  const groupsSub = $('groupsSub');
  const groupCount = $('groupCount');
  const groupsGoBtn = $('groupsGoBtn');
  const groupsDoneBtn = $('groupsDoneBtn');
  const groupsShareBtn = $('groupsShareBtn');
  const statsBackdrop = $('statsBackdrop');
  const statsSheet = $('statsSheet');
  const statsBody = $('statsBody');
  const statsSub = $('statsSub');
  const statsDoneBtn = $('statsDoneBtn');
  const backupInput = $('backupInput');
  const menuGroups = $('menuGroups');
  const menuPickN = $('menuPickN');
  const menuStats = $('menuStats');
  const menuSort = $('menuSort');
  const menuTimer = $('menuTimer');
  const menuShare = $('menuShare');
  const menuBackup = $('menuBackup');
  const menuRestore = $('menuRestore');
  const menuTheme = $('menuTheme');
  const menuSound = $('menuSound');
  const themeSw = $('themeSw');
  const soundSw = $('soundSw');
  const timerEl = $('timerEl');

  const STORAGE_KEY = 'randomizer-state-v4';
  const DEFAULT_NAMES = ['Andi','Budi','Cici','Dedi','Erlin','Fina','Gilang','Hana','Irfan','Joko'];

  let tabs = {};
  let currentTabId = null;
  let tabCounter = 0;
  let isSpinning = false;
  let spinRAF = null;
  let currentResult = '';
  let renameTarget = null;
  let lightTheme = false;
  let soundOn = false;
  let timerInterval = null;
  let timerRemaining = 0;
  let audioCtx = null;
  let lastGroupsResult = null;

  function toast(msg, type){
    const el = document.createElement('div');
    el.className = 'toast' + (type ? ' ' + type : '');
    el.textContent = msg;
    toastWrap.appendChild(el);
    setTimeout(() => el.remove(), 2400);
  }

  function escapeHtml(s){
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function parseNames(raw){
    const lines = raw.split(/[,;\n]+/).map(s => s.trim()).filter(s => s.length);
    const present = [], absent = [], all = [];
    for (const line of lines){
      if (line.startsWith('-') && line.length > 1){
        const name = line.slice(1).trim();
        if (name){ absent.push(name); all.push(line); }
      } else { present.push(line); all.push(line); }
    }
    return { all, present, absent };
  }

  function getCryptoRandomInt(max){
    if (max <= 1) return 0;
    if (window.crypto && window.crypto.getRandomValues){
      const maxValid = Math.floor(0x100000000 / max) * max;
      const arr = new Uint32Array(1);
      let r;
      do { window.crypto.getRandomValues(arr); r = arr[0]; } while (r >= maxValid);
      return r % max;
    }
    return Math.floor(Math.random() * max);
  }

  function pickRandom(arr){
    if (!arr || !arr.length) return null;
    if (arr.length === 1) return arr[0];
    return arr[getCryptoRandomInt(arr.length)];
  }

  function reconcileOrder(oldOrder, newPresent){
    const set = new Set(newPresent);
    const kept = (oldOrder || []).filter(n => set.has(n));
    const keptSet = new Set(kept);
    const added = newPresent.filter(n => !keptSet.has(n));
    return kept.concat(added);
  }

  function currentTab(){ return tabs[currentTabId]; }

  function persist(){
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ tabs, currentTabId, tabCounter })); } catch(e){}
  }

  function restore(){
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const data = JSON.parse(raw);
      if (!data || !data.tabs || typeof data.tabs !== 'object' || !Object.keys(data.tabs).length) return false;
      tabs = data.tabs;
      tabCounter = data.tabCounter || Object.keys(tabs).length;
      currentTabId = (data.currentTabId && tabs[data.currentTabId]) ? data.currentTabId : Object.keys(tabs)[0];
      for (const id of Object.keys(tabs)){
        const t = tabs[id];
        if (!Array.isArray(t.rawNames)) t.rawNames = Array.isArray(t.names) ? t.names.slice() : [];
        if (!Array.isArray(t.orderedNames)) t.orderedNames = t.rawNames.slice();
        if (!Array.isArray(t.history)) t.history = [];
        if (!Array.isArray(t.pickedSet)) t.pickedSet = [];
        if (typeof t.noRepeat !== 'boolean') t.noRepeat = true;
        if (t.previousOrder === undefined) t.previousOrder = null;
        if (typeof t.orderMode !== 'boolean') t.orderMode = false;
        if (typeof t.orderIndex !== 'number') t.orderIndex = -1;
      }
      return true;
    } catch(e){ return false; }
  }

  function createTabData(name, namesArray){
    const raw = (namesArray || []).slice();
    return {
      name: name || `Kelas ${tabCounter + 1}`,
      rawNames: raw, orderedNames: raw.slice(),
      orderMode: false, orderIndex: -1,
      noRepeat: true, pickedSet: [],
      history: [], previousOrder: null
    };
  }

  function addTab(name, namesArray){
    const id = 'tab-' + (++tabCounter);
    tabs[id] = createTabData(name, namesArray);
    renderTabs(); switchTab(id); persist();
    return id;
  }

  function removeTab(tabId){
    if (Object.keys(tabs).length <= 1){ toast('Minimal satu kelas.', 'error'); return; }
    if (!tabs[tabId]) return;
    if (!confirm(`Hapus kelas "${tabs[tabId].name}"?`)) return;
    if (currentTabId === tabId){
      const keys = Object.keys(tabs);
      const idx = keys.indexOf(tabId);
      const nextId = keys[(idx + 1) % keys.length];
      delete tabs[tabId];
      switchTab(nextId);
    } else { delete tabs[tabId]; }
    renderTabs(); persist();
  }

  function switchTab(tabId){
    if (currentTabId === tabId) return;
    if (currentTabId && tabs[currentTabId]) saveCurrentTab();
    currentTabId = tabId;
    loadTabData(tabId);
    renderTabs(); persist();
  }

  function saveCurrentTab(){
    const tab = currentTab();
    if (!tab) return;
    tab.rawNames = parseNames(textarea.value).all;
  }

  function loadTabData(tabId){
    const tab = tabs[tabId];
    if (!tab) return;
    textarea.value = tab.rawNames.join('\n');
    stopSpinning();
    updateStudentCount();
    updateModeBadge();
    updateRepeatIndicator();
    updateUndoBtn();
    syncNoRepeatSwitch();

    resultDisplay.classList.remove('picked','empty');
    hero.classList.remove('has-result');

    const parsed = parseNames(textarea.value);
    if (tab.orderMode && tab.orderIndex >= 0 && tab.orderIndex < tab.orderedNames.length){
      showResult(tab.orderedNames[tab.orderIndex], {picked:true, pop:false});
    } else if (tab.history.length){
      showResult(tab.history[0], {picked:true, pop:false});
    } else if (parsed.present.length === 1){
      showResult(parsed.present[0], {picked:true, pop:false});
    } else {
      showResult('', {empty:true, text:'Siap mengacak'});
    }
    renderHistory(); renderPreview(); renderTabs();
  }

  function showResult(name, opts){
    opts = opts || {};
    if (opts.empty || !name){
      resultDisplay.textContent = opts.text || 'Siap mengacak';
      resultDisplay.classList.add('empty');
      resultDisplay.classList.remove('picked');
      hero.classList.remove('has-result');
      currentResult = '';
      return;
    }
    resultDisplay.classList.remove('empty');
    resultDisplay.textContent = name;
    if (opts.picked !== false) resultDisplay.classList.add('picked');
    if (opts.pop && !isLowEnd){
      // restart animation tanpa baca layout setiap kali — pakai class toggle
      resultWrap.classList.remove('pop');
      void resultWrap.offsetWidth;   // 1 forced reflow, hanya saat pop
      resultWrap.classList.add('pop');
    }
    hero.classList.add('has-result');
    currentResult = name;
  }

  function renderTabs(){
    const keys = Object.keys(tabs).sort((a,b) => parseInt(a.split('-')[1]) - parseInt(b.split('-')[1]));
    let html = '';
    for (const id of keys){
      const active = id === currentTabId ? 'active' : '';
      html += `<button class="tab ${active}" data-tab="${id}">
        <span class="tn" data-tab="${id}">${escapeHtml(tabs[id].name)}</span>
        <span class="x" data-tab="${id}" aria-label="Tutup">✕</span>
      </button>`;
    }
    tabScroll.innerHTML = html;
    tabScroll.querySelectorAll('.tab').forEach(btn => {
      const id = btn.dataset.tab;
      btn.addEventListener('click', e => {
        if (e.target.classList.contains('x')){ e.stopPropagation(); removeTab(id); return; }
        if (id !== currentTabId) switchTab(id);
      });
      btn.querySelector('.tn').addEventListener('dblclick', e => { e.stopPropagation(); openRename(id); });
    });
  }

  function updateStudentCount(){
    const p = parseNames(textarea.value);
    let html = `<span class="num">${p.present.length}</span> siswa`;
    if (p.absent.length) html += ` <span class="absent">· ${p.absent.length} absen</span>`;
    studentCountSpan.innerHTML = html;
    sheetSub.textContent = `${p.present.length} siswa${p.absent.length ? ` · ${p.absent.length} absen` : ''}`;
    return p;
  }

  function updateModeBadge(){
    const tab = currentTab();
    const isOrder = !!(tab && tab.orderMode);
    modeBadge.textContent = isOrder ? '⏩ Urutan' : '⚡ Acak';
    modeBadge.classList.toggle('order', isOrder);
  }

  function updateRepeatIndicator(){
    const tab = currentTab();
    if (!tab || !tab.noRepeat){ repeatIndicator.hidden = true; return; }
    const p = parseNames(textarea.value);
    repeatIndicator.hidden = false;
    repeatIndicator.textContent = `${tab.pickedSet.length}/${p.present.length} terpilih`;
  }

  function updateUndoBtn(){
    const tab = currentTab();
    const ok = !!(tab && Array.isArray(tab.previousOrder) && tab.previousOrder.length);
    menuUndo.disabled = !ok;
    menuUndo.style.opacity = ok ? '1' : '.4';
  }

  function syncNoRepeatSwitch(){
    const tab = currentTab();
    noRepeatSw.classList.toggle('on', !!(tab && tab.noRepeat));
  }

  function renderHistory(){
    const tab = currentTab();
    if (!tab || !tab.history.length){ histWrap.hidden = true; historyStrip.innerHTML = ''; return; }
    histWrap.hidden = false;
    historyStrip.innerHTML = tab.history.slice(0, 25).map((n, i) =>
      `<span class="hist-chip${i === 0 ? ' latest' : ''}">${escapeHtml(n)}</span>`
    ).join('');
  }

  function renderPreview(){
    const tab = currentTab();
    if (!tab || !tab.orderMode || !tab.orderedNames.length){
      previewList.hidden = true; previewList.innerHTML = '';
      return;
    }
    const next = [];
    for (let i = 1; i <= 3; i++){
      const ni = tab.orderIndex + i;
      if (ni < tab.orderedNames.length) next.push(tab.orderedNames[ni]);
    }
    if (!next.length){ previewList.hidden = true; previewList.innerHTML = ''; return; }
    previewList.hidden = false;
    previewList.innerHTML = 'Berikutnya · ' +
      next.map(n => `<span class="upcoming">${escapeHtml(n)}</span>`).join(' → ');
  }

  function openRename(tabId){
    renameTarget = tabId;
    renameInput.value = tabs[tabId].name;
    renameBackdrop.classList.add('show');
    setTimeout(() => { renameInput.focus(); renameInput.select(); }, 60);
  }
  function closeRename(){ renameBackdrop.classList.remove('show'); renameTarget = null; }

  renameCancel.addEventListener('click', closeRename);
  renameBackdrop.addEventListener('click', e => { if (e.target === renameBackdrop) closeRename(); });
  renameConfirm.addEventListener('click', () => {
    if (renameTarget && tabs[renameTarget]){
      const v = renameInput.value.trim();
      tabs[renameTarget].name = v || tabs[renameTarget].name;
      renderTabs(); persist();
    }
    closeRename();
  });
  renameInput.addEventListener('keydown', e => {
    if (e.key === 'Enter') renameConfirm.click();
    if (e.key === 'Escape') closeRename();
  });

  function stopSpinning(){
    if (spinRAF){ cancelAnimationFrame(spinRAF); spinRAF = null; }
    isSpinning = false;
    pickBtn.disabled = false;
    shuffleBtn.disabled = false;
    nextOrderBtn.disabled = false;
    updateUndoBtn();
  }

  function vibrate(ms){ try { navigator.vibrate && navigator.vibrate(ms); } catch(e){} }

  /* Spin pakai requestAnimationFrame dengan throttle.
     - low-end: ~33ms/frame (30fps), 12 langkah
     - normal : ~60ms/frame awal, makin lambat, 14 langkah
     Tidak ada setTimeout chain, tidak ada forced reflow per frame. */
  function spinEffect(pool, callback){
    if (isSpinning) return;
    if (!pool || !pool.length){ showResult('', {empty:true, text:'Belum ada nama'}); return; }

    isSpinning = true;
    pickBtn.disabled = true; shuffleBtn.disabled = true; nextOrderBtn.disabled = true;
    menuUndo.disabled = true;

    // Frame budget
    const totalSteps = isLowEnd ? 12 : 14;
    const baseDelay  = isLowEnd ? 80 : 60;   // ms
    const stepDelay  = isLowEnd ? 14 : 12;   // penambahan per step

    let step = 0;
    let lastTick = 0;

    function tick(now){
      if (!isSpinning) return;
      if (lastTick === 0) lastTick = now;
      const elapsed = now - lastTick;
      const delay = baseDelay + step * stepDelay;

      if (elapsed >= delay){
        lastTick = now;
        // update teks langsung (1 write per frame)
        resultDisplay.classList.remove('empty','picked');
        resultDisplay.textContent = pool[(Math.random() * pool.length) | 0];
        hero.classList.remove('has-result');
        Sound.tick();
        step++;
      }

      if (step >= totalSteps){
        // finalize
        const finalName = pickRandom(pool);
        isSpinning = false;
        spinRAF = null;
        pickBtn.disabled = false; shuffleBtn.disabled = false; nextOrderBtn.disabled = false;
        updateUndoBtn();
        showResult(finalName || '', {picked:true, pop:true, empty: !finalName, text:'⚠️ Error'});
        vibrate(isLowEnd ? 25 : 40);
        if (finalName) Sound.pick(); else Sound.error();
        if (callback) callback(finalName);
        return;
      }
      spinRAF = requestAnimationFrame(tick);
    }

    spinRAF = requestAnimationFrame(tick);
  }

  function finishPick(name){
    const tab = currentTab();
    if (!tab || !name) return;
    if (tab.noRepeat && !tab.pickedSet.includes(name)) tab.pickedSet.push(name);
    tab.history.unshift(name);
    if (tab.history.length > 30) tab.history.length = 30;
    tab.orderMode = false; tab.orderIndex = -1;
    updateModeBadge(); updateRepeatIndicator();
    renderHistory(); renderPreview();
    persist();
  }

  function doPick(){
    if (isSpinning) return;
    const tab = currentTab();
    if (!tab) return;
    const p = parseNames(textarea.value);
    if (!p.present.length){
      showResult('', {empty:true, text:'❌ Tidak ada nama'});
      Sound.error();
      tab.orderMode = false;
      updateModeBadge(); updateRepeatIndicator();
      return;
    }
    let pool = p.present;
    if (tab.noRepeat){
      const picked = new Set(tab.pickedSet);
      pool = p.present.filter(n => !picked.has(n));
      if (!pool.length){
        tab.pickedSet = [];
        pool = p.present;
        toast('Semua sudah terpilih. Pool di-reset.', 'info');
      }
    }
    if (pool.length === 1){
      showResult(pool[0], {picked:true, pop:true});
      vibrate(isLowEnd ? 25 : 40);
      Sound.pick();
      finishPick(pool[0]);
      return;
    }
    spinEffect(pool, name => { if (name) finishPick(name); });
  }

  function nextOrder(){
    if (isSpinning) return;
    const tab = currentTab();
    if (!tab) return;
    const p = parseNames(textarea.value);
    if (!p.present.length){
      showResult('', {empty:true, text:'❌ Tidak ada nama'});
      Sound.error();
      tab.orderMode = false;
      updateModeBadge();
      return;
    }
    tab.orderedNames = reconcileOrder(tab.orderedNames || [], p.present);
    if (tab.orderMode && tab.orderIndex >= 0 && tab.orderIndex < tab.orderedNames.length - 1){
      tab.orderIndex++;
    } else { tab.orderIndex = 0; }
    tab.orderMode = true;
    const name = tab.orderedNames[tab.orderIndex];
    showResult(name, {picked:true, pop:true});
    vibrate(20);
    Sound.success();
    tab.history.unshift(name);
    if (tab.history.length > 30) tab.history.length = 30;
    updateModeBadge();
    renderHistory(); renderPreview();
    persist();
  }

  function shuffleOrder(){
    if (isSpinning) return;
    const tab = currentTab();
    if (!tab) return;
    const p = parseNames(textarea.value);
    if (!p.present.length){ toast('Belum ada nama.', 'error'); return; }

    tab.previousOrder = tab.rawNames.slice();
    Sound.whoosh();

    const sh = p.present.slice();
    for (let i = sh.length - 1; i > 0; i--){
      const j = getCryptoRandomInt(i + 1);
      [sh[i], sh[j]] = [sh[j], sh[i]];
    }
    const newRaw = sh.concat(p.absent.map(n => '-' + n));
    tab.rawNames = newRaw;
    tab.orderedNames = sh.slice();
    tab.orderMode = true;
    tab.orderIndex = 0;
    tab.pickedSet = [];

    textarea.value = newRaw.join('\n');
    updateStudentCount();
    updateModeBadge();
    updateRepeatIndicator();
    updateUndoBtn();

    showResult(sh[0], {picked:true, pop:true});
    vibrate(isLowEnd ? [10,25,10] : [20, 40, 20]);
    Sound.pick();
    tab.history.unshift(sh[0]);
    if (tab.history.length > 30) tab.history.length = 30;

    renderHistory(); renderPreview();
    persist();
    toast('Urutan diacak.', 'success');
  }

  function undoShuffle(){
    const tab = currentTab();
    if (!tab || !tab.previousOrder){ toast('Tidak ada yang bisa di-undo.', 'error'); return; }
    tab.rawNames = tab.previousOrder.slice();
    tab.orderedNames = tab.previousOrder.slice();
    tab.previousOrder = null;
    tab.orderMode = false; tab.orderIndex = -1; tab.pickedSet = [];
    textarea.value = tab.rawNames.join('\n');
    updateStudentCount(); updateModeBadge(); updateRepeatIndicator(); updateUndoBtn();
    renderPreview();
    persist();
    toast('Shuffle dibatalkan.', 'success');
  }

  function doReset(){
    const tab = currentTab();
    if (!tab) return;
    tab.rawNames = DEFAULT_NAMES.slice();
    tab.orderedNames = DEFAULT_NAMES.slice();
    tab.orderMode = false; tab.orderIndex = -1;
    tab.noRepeat = true;
    tab.pickedSet = []; tab.history = []; tab.previousOrder = null;
    loadTabData(currentTabId); persist();
    toast('Direset ke contoh.', 'success');
  }

  function copyResult(){
    const text = currentResult;
    if (!text){ toast('Belum ada hasil untuk disalin.', 'error'); return; }
    const done = () => toast('Disalin ke clipboard.', 'success');
    const fail = () => toast('Gagal menyalin.', 'error');
    if (navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done, fail));
    } else fallbackCopy(text, done, fail);
  }
  function fallbackCopy(text, done, fail){
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); done(); } catch(e){ fail(); }
    document.body.removeChild(ta);
  }

  function doExport(){
    const tab = currentTab();
    if (!tab || !tab.history.length){ toast('Belum ada riwayat.', 'error'); return; }
    const lines = [
      'Riwayat Hasil — ' + tab.name,
      'Tanggal: ' + new Date().toLocaleString('id-ID'),
      '',
      ...tab.history.map((n, i) => `${i + 1}. ${n}`)
    ];
    const blob = new Blob([lines.join('\n')], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `hasil_${(tab.name || 'kelas').replace(/\s+/g,'_')}_${Date.now()}.txt`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast('Ekspor berhasil.', 'success');
  }

  /* ---------- Excel ---------- */
  function handleExcelUpload(file){
    const reader = new FileReader();
    reader.onload = function(e){
      try {
        const data = new Uint8Array(e.target.result);
        const wb = XLSX.read(data, { type: 'array' });
        const nameKeys = ['nama','name','siswa','student','murid','peserta'];
        const noKeys = ['no','nomor','no.','number','#','id'];

        function extract(sheetName){
          const ws = wb.Sheets[sheetName];
          const json = XLSX.utils.sheet_to_json(ws, { header: 1 });
          if (!json || !json.length) return [];
          let firstRowIdx = 0;
          for (let i = 0; i < Math.min(json.length, 10); i++){
            const row = json[i];
            if (row && row.some(c => c !== undefined && c !== null && String(c).trim() !== '')){
              firstRowIdx = i; break;
            }
          }
          const firstRow = json[firstRowIdx] || [];
          let headerColIdx = -1;
          for (let i = 0; i < firstRow.length; i++){
            const h = String(firstRow[i] || '').toLowerCase().trim();
            if (nameKeys.some(k => h === k || h.includes(k))){ headerColIdx = i; break; }
          }
          const names = [];
          if (headerColIdx !== -1){
            for (let i = firstRowIdx + 1; i < json.length; i++){
              const v = json[i] && json[i][headerColIdx];
              if (v !== undefined && v !== null && String(v).trim() !== '') names.push(String(v).trim());
            }
          } else {
            let start = firstRowIdx;
            const fc = String(firstRow[0] || '').toLowerCase().trim();
            if (noKeys.includes(fc)) start = firstRowIdx + 1;
            for (let i = start; i < json.length; i++){
              const v = json[i] && json[i][0];
              if (v !== undefined && v !== null && String(v).trim() !== '') names.push(String(v).trim());
            }
          }
          return names;
        }

        const results = wb.SheetNames
          .map(sn => ({ name: sn, names: extract(sn) }))
          .filter(r => r.names.length);

        if (!results.length){ toast('Nama tidak ditemukan di file.', 'error'); return; }

        saveCurrentTab();

        if (results.length === 1){
          const { names } = results[0];
          const tab = currentTab();
          tab.rawNames = names.slice();
          tab.orderedNames = names.slice();
          tab.orderMode = false; tab.orderIndex = -1;
          tab.pickedSet = []; tab.history = []; tab.previousOrder = null;
          loadTabData(currentTabId);
          persist();
          toast(`Import ${names.length} siswa berhasil.`, 'success');
        } else {
          let firstId = null;
          for (const r of results){
            const id = 'tab-' + (++tabCounter);
            tabs[id] = createTabData(r.name, r.names);
            if (!firstId) firstId = id;
          }
          currentTabId = firstId;
          renderTabs(); loadTabData(firstId); persist();
          toast(`Import ${results.length} sheet → ${results.length} kelas.`, 'success');
        }
      } catch(err){
        toast('Gagal baca Excel: ' + err.message, 'error');
      }
    };
    reader.readAsArrayBuffer(file);
  }

  /* ---------- Sheet ---------- */
  function openSheet(){
    sheetBackdrop.classList.add('show');
    sheet.classList.add('show');
    updateStudentCount();
    setTimeout(() => { textarea.focus(); }, 280);
  }
  function closeSheet(){
    sheetBackdrop.classList.remove('show');
    sheet.classList.remove('show');
    textarea.blur();
    const tab = currentTab();
    if (tab){
      const p = parseNames(textarea.value);
      tab.rawNames = p.all;
      if (tab.orderMode) tab.orderedNames = reconcileOrder(tab.orderedNames || [], p.present);
      if (tab.noRepeat){
        const set = new Set(p.present);
        tab.pickedSet = tab.pickedSet.filter(n => set.has(n));
      }
      updateStudentCount(); updateModeBadge(); updateRepeatIndicator();
      renderPreview(); persist();
    }
  }

  /* ---------- Menu ---------- */
  function openMenu(){ menu.classList.add('show'); menuBackdrop.classList.add('show'); }
  function closeMenu(){ menu.classList.remove('show'); menuBackdrop.classList.remove('show'); }

  /* ============ THEME ============ */
  function applyTheme(theme){
    document.documentElement.setAttribute('data-theme', theme);
    lightTheme = (theme === 'light');
    try { localStorage.setItem('acak-theme', theme); } catch(e){}
    if (typeof themeSw !== 'undefined' && themeSw) themeSw.classList.toggle('on', lightTheme);
  }
  function toggleTheme(){
    applyTheme(lightTheme ? 'dark' : 'light');
    toast(lightTheme ? 'Mode terang' : 'Mode gelap', 'info');
  }

  /* ============ SOUND ============ */
  /* ============ SOUND ENGINE (Web Audio API) ============ */
  const Sound = {
    ctx: null,
    enabled: false,

    init: function(){
      if (this.ctx) return;
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (AC) this.ctx = new AC();
      } catch(e){}
    },

    resume: function(){
      if (this.ctx && this.ctx.state === 'suspended'){
        this.ctx.resume().catch(function(){});
      }
    },

    setEnabled: function(on){
      this.enabled = !!on;
      if (on){ this.init(); this.resume(); }
    },

    /* Basic tone with attack+release envelope */
    tone: function(freq, dur, type, vol, delay){
      if (!this.enabled || !this.ctx) return;
      try {
        const t = this.ctx.currentTime + (delay || 0);
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type || 'sine';
        osc.frequency.setValueAtTime(freq, t);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(vol || 0.2, t + 0.008);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + dur);
        osc.start(t);
        osc.stop(t + dur + 0.03);
      } catch(e){}
    },

    /* --- Predefined sounds --- */

    // Tick selama spin (random pitch, biar seru)
    tick: function(){
      const f = 1200 + ((Math.random() * 500) | 0);
      this.tone(f, 0.025, 'square', 0.045);
    },

    // Klik kecil untuk tombol
    click: function(){
      this.tone(900, 0.03, 'triangle', 0.06);
    },

    // Switch ON: 2 nada naik
    toggle: function(){
      this.tone(880, 0.05, 'sine', 0.12);
      this.tone(1320, 0.08, 'sine', 0.12, 0.06);
    },

    // Sukses singkat
    success: function(){
      this.tone(587.33, 0.12, 'triangle', 0.16);
      this.tone(880, 0.18, 'triangle', 0.16, 0.08);
    },

    // Error: buzz turun
    error: function(){
      this.tone(220, 0.15, 'sawtooth', 0.12);
      this.tone(165, 0.22, 'sawtooth', 0.12, 0.12);
    },

    // Fanfare nama terpilih: C5-E5-G5-C6 (do-mi-sol-do)
    pick: function(){
      const notes = [523.25, 659.25, 783.99, 1046.5];
      for (let i = 0; i < notes.length; i++){
        this.tone(notes[i], 0.38, 'triangle', 0.24, i * 0.075);
        this.tone(notes[i] * 2, 0.18, 'sine', 0.06, i * 0.075);
      }
    },

    // Bagi kelompok: arpeggio naik 5 nada
    groups: function(){
      const notes = [523.25, 659.25, 783.99, 1046.5, 1318.5];
      for (let i = 0; i < notes.length; i++){
        this.tone(notes[i], 0.22, 'sine', 0.15, i * 0.05);
      }
    },

    // Timer habis: bel alarm 3x
    timerEnd: function(){
      for (let i = 0; i < 3; i++){
        this.tone(880, 0.18, 'sine', 0.28, i * 0.28);
        this.tone(1318.5, 0.18, 'sine', 0.2, i * 0.28);
        this.tone(440, 0.28, 'triangle', 0.12, i * 0.28);
      }
    },

    // Kocok: sweep naik cepat
    whoosh: function(){
      if (!this.enabled || !this.ctx) return;
      try {
        const t = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(280, t);
        osc.frequency.exponentialRampToValueAtTime(1400, t + 0.22);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(0.16, t + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.24);
        osc.start(t);
        osc.stop(t + 0.27);
      } catch(e){}
    }
  };
  function toggleSound(){
    soundOn = !soundOn;
    soundSw.classList.toggle('on', soundOn);
    try { localStorage.setItem('acak-sound', soundOn ? '1' : '0'); } catch(e){}
    Sound.setEnabled(soundOn);
    if (soundOn) Sound.toggle();
    toast(soundOn ? 'Suara: aktif' : 'Suara: mati', 'info');
  }

  /* ============ TIMER ============ */
  function updateTimerDisplay(){
    const m = Math.floor(timerRemaining / 60);
    const s = String(timerRemaining % 60).padStart(2, '0');
    timerEl.textContent = m + ':' + s;
    timerEl.classList.toggle('ending', timerRemaining <= 10);
  }
  function stopTimer(){
    if (timerInterval){ clearInterval(timerInterval); timerInterval = null; }
    timerEl.hidden = true;
  }
  function startTimerDialog(){
    if (timerInterval){
      stopTimer();
      toast('Timer dihentikan.', 'info');
      return;
    }
    const ans = prompt('Timer berapa menit?\n(1-60)', '5');
    if (!ans) return;
    const n = parseInt(ans);
    if (isNaN(n) || n < 1 || n > 60){ toast('Angka tidak valid.', 'error'); return; }
    timerRemaining = n * 60;
    updateTimerDisplay();
    timerEl.hidden = false;
    timerInterval = setInterval(function(){
      timerRemaining--;
      updateTimerDisplay();
      if (timerRemaining <= 0){
        stopTimer();
        Sound.timerEnd();
        vibrate([120, 60, 120, 60, 120]);
        toast('⏰ Waktu habis!', 'info');
      }
    }, 1000);
    toast('Timer ' + n + ' menit dimulai.', 'info');
  }

  /* ============ GROUPS ============ */
  function shuffleArr(arr){
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--){
      const j = getCryptoRandomInt(i + 1);
      const t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }
  function doDivideGroups(n){
    const tab = currentTab();
    if (!tab) return;
    const p = parseNames(textarea.value);
    if (p.present.length < 2){ toast('Butuh minimal 2 siswa.', 'error'); return; }
    if (n < 2 || n > p.present.length){ toast('Jumlah kelompok tidak valid.', 'error'); return; }

    const shuffled = shuffleArr(p.present);
    const groups = [];
    for (let i = 0; i < n; i++) groups.push([]);
    shuffled.forEach(function(name, i){ groups[i % n].push(name); });

    lastGroupsResult = groups;
    renderGroups(groups);
    persist();
    Sound.groups();
    vibrate(20);
  }
  function renderGroups(groups){
    const total = groups.reduce(function(s, g){ return s + g.length; }, 0);
    groupsSub.textContent = groups.length + ' kelompok · ' + total + ' siswa';
    groupsBody.innerHTML = groups.map(function(g, i){
      return '<div class="group-card">'
        + '<div class="group-title"><span>Kelompok ' + (i + 1) + '</span>'
        + '<span class="cnt">' + g.length + ' orang</span></div>'
        + '<ol class="group-list">'
        + g.map(function(n){ return '<li>' + escapeHtml(n) + '</li>'; }).join('')
        + '</ol></div>';
    }).join('');
  }
  function openGroupsSheet(){
    const tab = currentTab();
    if (!tab) return;
    const p = parseNames(textarea.value);
    if (p.present.length < 2){ toast('Belum cukup siswa.', 'error'); return; }
    // Set max
    groupCount.max = Math.min(20, p.present.length);
    groupCount.value = Math.min(parseInt(groupCount.value) || 4, p.present.length);
    groupsBackdrop.classList.add('show');
    groupsSheet.classList.add('show');
  }
  function closeGroupsSheet(){
    groupsBackdrop.classList.remove('show');
    groupsSheet.classList.remove('show');
  }
  function shareGroups(){
    if (!lastGroupsResult){ toast('Belum ada hasil bagi kelompok.', 'error'); return; }
    const tab = currentTab();
    let text = 'Kelompok — ' + (tab ? tab.name : '') + '\n\n';
    lastGroupsResult.forEach(function(g, i){
      text += 'Kelompok ' + (i + 1) + ':\n';
      g.forEach(function(n, j){ text += (j + 1) + '. ' + n + '\n'; });
      text += '\n';
    });
    if (navigator.share){
      navigator.share({ title: 'Bagi Kelompok', text: text }).catch(function(){});
    } else {
      fallbackCopy(text, function(){ toast('Disalin.', 'success'); }, function(){ toast('Gagal.', 'error'); });
    }
  }

  /* ============ STATS ============ */
  function showStats(){
    const tab = currentTab();
    if (!tab){ return; }
    const p = parseNames(textarea.value);
    const counts = {};
    (tab.history || []).forEach(function(n){ counts[n] = (counts[n] || 0) + 1; });
    const entries = Object.keys(counts).map(function(k){ return [k, counts[k]]; })
                          .sort(function(a, b){ return b[1] - a[1]; });

    statsSub.textContent = (tab.history ? tab.history.length : 0) + ' kali acak';
    let html = '';

    if (entries.length === 0){
      html = '<div class="stats-empty">Belum ada riwayat acak.<br>Klik 🎲 Acak dulu.</div>';
    } else {
      const max = entries[0][1];
      html += '<div class="stats-section">';
      html += '<div class="stats-title">Paling sering keluar</div>';
      entries.slice(0, 15).forEach(function(e){
        const name = e[0], c = e[1];
        const pct = Math.max(8, (c / max) * 100);
        html += '<div class="stat-row">'
          + '<span class="stat-name">' + escapeHtml(name) + '</span>'
          + '<div class="stat-bar"><div class="stat-fill" style="width:' + pct + '%"></div></div>'
          + '<span class="stat-count">' + c + '×</span>'
          + '</div>';
      });
      html += '</div>';

      const never = p.present.filter(function(n){ return !counts[n]; });
      if (never.length){
        html += '<div class="stats-section">';
        html += '<div class="stats-title">Belum pernah keluar (' + never.length + ')</div>';
        html += '<div class="stats-never">' + never.map(escapeHtml).join(', ') + '</div>';
        html += '</div>';
      }
    }
    statsBody.innerHTML = html;
    statsBackdrop.classList.add('show');
    statsSheet.classList.add('show');
  }
  function closeStatsSheet(){
    statsBackdrop.classList.remove('show');
    statsSheet.classList.remove('show');
  }

  /* ============ PICK N ============ */
  function pickN(){
    if (isSpinning) return;
    const tab = currentTab();
    if (!tab) return;
    const p = parseNames(textarea.value);
    if (!p.present.length){ toast('Belum ada nama.', 'error'); return; }

    const ans = prompt('Berapa nama yang mau diacak sekaligus?\n(1-' + p.present.length + ')', '3');
    if (!ans) return;
    const n = parseInt(ans);
    if (isNaN(n) || n < 1 || n > p.present.length){ toast('Angka tidak valid.', 'error'); return; }

    let pool = p.present.slice();
    if (tab.noRepeat){
      const picked = new Set(tab.pickedSet);
      pool = pool.filter(function(x){ return !picked.has(x); });
      if (pool.length < n){
        toast('Sisa siswa kurang. Pool di-reset.', 'info');
        tab.pickedSet = [];
        pool = p.present.slice();
      }
    }

    const shuffled = shuffleArr(pool).slice(0, n);
    const text = shuffled.join(', ');

    resultDisplay.classList.remove('empty');
    resultDisplay.classList.add('picked');
    resultDisplay.textContent = text;
    currentResult = text;
    hero.classList.add('has-result');
    Sound.pick();
    vibrate([20, 30, 20]);

    shuffled.forEach(function(name){
      if (tab.noRepeat && !tab.pickedSet.includes(name)) tab.pickedSet.push(name);
      tab.history.unshift(name);
    });
    if (tab.history.length > 30) tab.history.length = 30;
    tab.orderMode = false; tab.orderIndex = -1;
    updateModeBadge(); updateRepeatIndicator();
    renderHistory(); renderPreview();
    persist();
    toast(n + ' nama diacak.', 'success');
  }

  /* ============ SORT ============ */
  function sortAZ(){
    const tab = currentTab();
    if (!tab) return;
    const p = parseNames(textarea.value);
    if (p.present.length < 2){ toast('Belum ada nama.', 'error'); return; }
    const sorted = p.present.slice().sort(function(a, b){ return a.localeCompare(b, 'id'); });
    const newRaw = sorted.concat(p.absent.map(function(n){ return '-' + n; }));
    tab.rawNames = newRaw;
    tab.orderedNames = sorted.slice();
    tab.orderMode = false; tab.orderIndex = -1;
    textarea.value = newRaw.join('\n');
    updateStudentCount(); updateModeBadge(); updateRepeatIndicator();
    renderPreview(); persist();
    toast('Diurutkan A-Z.', 'success');
  }

  /* ============ SHARE ============ */
  function shareResult(){
    if (!currentResult){ toast('Belum ada hasil.', 'error'); return; }
    const text = 'Hasil acak: ' + currentResult;
    if (navigator.share){
      navigator.share({ title: 'Acak Siswa', text: text }).catch(function(){});
    } else {
      fallbackCopy(text, function(){ toast('Disalin.', 'success'); }, function(){ toast('Gagal.', 'error'); });
    }
  }

  /* ============ BACKUP / RESTORE ============ */
  function exportBackup(){
    const data = {
      app: 'acak-siswa',
      version: 2,
      exported: new Date().toISOString(),
      tabs: tabs,
      tabCounter: tabCounter,
      currentTabId: currentTabId
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const d = new Date();
    const pad = function(x){ return String(x).padStart(2, '0'); };
    a.href = url;
    a.download = 'acak-backup-' + d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate())
               + '-' + pad(d.getHours()) + pad(d.getMinutes()) + '.json';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast('Backup tersimpan.', 'success');
  }
  function importBackup(file){
    const reader = new FileReader();
    reader.onload = function(e){
      try {
        const data = JSON.parse(e.target.result);
        if (!data || !data.tabs || typeof data.tabs !== 'object'){
          throw new Error('File backup tidak valid.');
        }
        const nTabs = Object.keys(data.tabs).length;
        if (!confirm('Restore ' + nTabs + ' kelas dari backup?\n\nSemua data SEKARANG akan digantikan.')) return;

        tabs = data.tabs;
        tabCounter = data.tabCounter || nTabs;
        currentTabId = (data.currentTabId && tabs[data.currentTabId]) ? data.currentTabId : Object.keys(tabs)[0];

        for (const id of Object.keys(tabs)){
          const t = tabs[id];
          if (!Array.isArray(t.rawNames)) t.rawNames = [];
          if (!Array.isArray(t.orderedNames)) t.orderedNames = t.rawNames.slice();
          if (!Array.isArray(t.history)) t.history = [];
          if (!Array.isArray(t.pickedSet)) t.pickedSet = [];
          if (typeof t.noRepeat !== 'boolean') t.noRepeat = true;
          if (t.previousOrder === undefined) t.previousOrder = null;
          if (typeof t.orderMode !== 'boolean') t.orderMode = false;
          if (typeof t.orderIndex !== 'number') t.orderIndex = -1;
        }
        renderTabs(); loadTabData(currentTabId); persist();
        toast('Restore berhasil: ' + nTabs + ' kelas.', 'success');
      } catch(err){
        toast('Gagal restore: ' + err.message, 'error');
      }
    };
    reader.readAsText(file);
  }

  /* Auto-unlock AudioContext saat interaksi pertama (kebijakan autoplay) */
  document.addEventListener('pointerdown', function(){ Sound.resume(); }, { passive: true });

  /* ---------- Events ---------- */
  menuGroups.addEventListener('click', function(e){ e.stopPropagation(); closeMenu(); openGroupsSheet(); });
  menuPickN.addEventListener('click', function(e){ e.stopPropagation(); closeMenu(); pickN(); });
  menuStats.addEventListener('click', function(e){ e.stopPropagation(); closeMenu(); showStats(); });
  menuSort.addEventListener('click', function(e){ e.stopPropagation(); closeMenu(); sortAZ(); });
  menuTimer.addEventListener('click', function(e){ e.stopPropagation(); closeMenu(); startTimerDialog(); });
  menuShare.addEventListener('click', function(e){ e.stopPropagation(); closeMenu(); shareResult(); });
  menuBackup.addEventListener('click', function(e){ e.stopPropagation(); closeMenu(); exportBackup(); });
  menuRestore.addEventListener('click', function(e){ e.stopPropagation(); closeMenu(); backupInput.click(); });
  menuTheme.addEventListener('click', function(e){ e.stopPropagation(); toggleTheme(); });
  menuSound.addEventListener('click', function(e){ e.stopPropagation(); toggleSound(); });

  groupsGoBtn.addEventListener('click', function(){
    const n = parseInt(groupCount.value);
    if (isNaN(n) || n < 2){ toast('Minimal 2 kelompok.', 'error'); return; }
    doDivideGroups(n);
  });
  groupsDoneBtn.addEventListener('click', closeGroupsSheet);
  groupsBackdrop.addEventListener('click', closeGroupsSheet);
  groupsShareBtn.addEventListener('click', shareGroups);

  statsDoneBtn.addEventListener('click', closeStatsSheet);
  statsBackdrop.addEventListener('click', closeStatsSheet);

  backupInput.addEventListener('change', function(){
    if (this.files && this.files.length) importBackup(this.files[0]);
    this.value = '';
  });

  const excelBtn = document.getElementById('excelBtn');
  if (excelBtn) excelBtn.addEventListener('click', function(){ excelInput.click(); });
    pickBtn.addEventListener('click', doPick);
  nextOrderBtn.addEventListener('click', nextOrder);
  shuffleBtn.addEventListener('click', shuffleOrder);
  copyBtn.addEventListener('click', copyResult);
  openListBtn.addEventListener('click', openSheet);
  sheetDoneBtn.addEventListener('click', closeSheet);
  sheetBackdrop.addEventListener('click', closeSheet);
  sheetClearBtn.addEventListener('click', () => {
    if (!textarea.value.trim()) return;
    if (!confirm('Kosongkan daftar siswa?')) return;
    textarea.value = '';
    textarea.dispatchEvent(new Event('input'));
    toast('Daftar dikosongkan.', 'info');
  });

  menuBtn.addEventListener('click', e => { e.stopPropagation(); menu.classList.contains('show') ? closeMenu() : openMenu(); });
  menuBackdrop.addEventListener('click', closeMenu);

  menuNoRepeat.addEventListener('click', e => {
    e.stopPropagation();
    const tab = currentTab();
    if (!tab) return;
    tab.noRepeat = !tab.noRepeat;
    syncNoRepeatSwitch();
    updateRepeatIndicator();
    persist();
    toast(tab.noRepeat ? 'Tanpa ulang: AKTIF' : 'Tanpa ulang: NONAKTIF', 'info');
  });
  menuUndo.addEventListener('click', e => { e.stopPropagation(); closeMenu(); undoShuffle(); });
  menuExcel.addEventListener('click', e => { e.stopPropagation(); closeMenu(); excelInput.click(); });
  menuExport.addEventListener('click', e => { e.stopPropagation(); closeMenu(); doExport(); });
  menuReset.addEventListener('click', e => { e.stopPropagation(); closeMenu(); doReset(); });

  excelInput.addEventListener('change', function(){
    if (this.files && this.files.length) handleExcelUpload(this.files[0]);
    this.value = '';
  });

  addTabBtn.addEventListener('click', () => {
    const id = addTab(`Kelas ${tabCounter + 1}`, []);
    openRename(id);
  });

  textarea.addEventListener('input', function(){
    if (isSpinning) return;
    const tab = currentTab();
    if (!tab) return;
    const p = parseNames(this.value);
    tab.rawNames = p.all;

    if (tab.orderMode){
      tab.orderedNames = reconcileOrder(tab.orderedNames || [], p.present);
      if (!tab.orderedNames.length){ tab.orderMode = false; tab.orderIndex = -1; }
      else if (tab.orderIndex >= tab.orderedNames.length) tab.orderIndex = tab.orderedNames.length - 1;
    }
    if (tab.noRepeat){
      const set = new Set(p.present);
      tab.pickedSet = tab.pickedSet.filter(n => set.has(n));
    }
    updateStudentCount();
    updateModeBadge(); updateRepeatIndicator();
    renderPreview();

    if (!p.present.length){
      showResult('', {empty:true, text:'Daftar kosong'});
    } else if (currentResult && !p.present.includes(currentResult)){
      showResult('', {empty:true, text:'Siap mengacak'});
    } else if (p.present.length === 1 && !currentResult){
      showResult(p.present[0], {picked:true, pop:false});
    }
    persist();
  });

  document.addEventListener('keydown', function(e){
    if (e.target === textarea || e.target === renameInput) return;
    if (e.target.tagName === 'BUTTON' || e.target.tagName === 'INPUT' || e.target.isContentEditable) return;
    if (e.key === 'Escape'){ closeMenu(); closeSheet(); return; }
    if (e.code === 'Space' && !e.repeat && !isSpinning){
      e.preventDefault(); doPick();
    }
  });

  /* Pause rAF saat tab tidak aktif — hemat baterai & CPU */
  document.addEventListener('visibilitychange', () => {
    if (document.hidden && spinRAF){
      cancelAnimationFrame(spinRAF);
      spinRAF = null;
      isSpinning = false;
      pickBtn.disabled = false; shuffleBtn.disabled = false; nextOrderBtn.disabled = false;
      updateUndoBtn();
    }
  });

  /* ---------- Init ---------- */
  (function init(){
    if (!restore()){
      const id = 'tab-1';
      tabs[id] = createTabData('Kelas 1', DEFAULT_NAMES.slice());
      currentTabId = id;
      tabCounter = 1;
    }
    renderTabs();
    loadTabData(currentTabId);
  })();


  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function(){
      navigator.serviceWorker.register('./sw.js').catch(function(){});
    });
  }
})();
</script>
</body>
</html>
